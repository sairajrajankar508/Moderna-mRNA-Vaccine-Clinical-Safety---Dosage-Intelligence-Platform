# Copy this file to .env and fill in ONE API key. Never commit .env.
# With no key, the pipeline still runs and uses the offline grounded generator.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional settings
# LLM_PROVIDER=auto            # auto | anthropic | openai | offline
# LLM_MODEL=                   # defaults: claude-haiku-5-5 (Anthropic), gpt-4o-mini (OpenAI)
# For the submission run, keep huggingface so a failed model download is an error, not a silent
# switch to the offline embedder. Use auto to allow the offline fallback.
EMBEDDING_BACKEND=huggingface
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ELEVATED_BIOMARKER_MG_L=10.0 # project assumption, see src/guardrails.py
